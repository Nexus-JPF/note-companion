### The fastest way to get started is just to add your OpenAI API key to the .env file.
OPENAI_API_KEY="sk-xxxx"
OPENAI_API_BASE=""  # The base URL for OpenAI API
# OPENAI_WHISPER_BASE_URL=  # Optional; Whisper/transcription endpoint (defaults to OPENAI_API_BASE)
GROQ_API_KEY="gsk-xxxx"
GROQ_API_BASE=""  # The base URL for Groq API
ANTHROPIC_API_KEY="sk-xxxx"
ANTHROPIC_API_BASE=""  # The base URL for Anthropic API
GOOGLE_API_KEY="sk-xxxx"
GOOGLE_API_BASE=""  # The base URL for Google API
DEEPSEEK_API_KEY="sk-xxxx"
DEEPSEEK_API_BASE=""  # The base URL for DeepSeek API
MISTRAL_API_KEY="sk-xxxx"  # The API key for Mistral AI OCR

# AI models (OpenAI). Unset → MODEL_PROVIDER=openai, MODEL_NAME=gpt-5.6-luna
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-5.6-luna              # Organizer, classify, tag, extract
# RESPONSES_MODEL_NAME=gpt-5.6-luna    # Chat + web search (OpenAI Responses API only; defaults to MODEL_NAME)
# VISION_MODEL=gpt-5.6-luna            # OCR / vision (defaults to gpt-5.6-luna)
# VISION_FALLBACK_MODEL=gpt-5.6-terra  # Second vision model when primary refuses (OpenAI cloud only)
# IMAGE_MODEL=gpt-image-2.5-flare      # Magic Diagram (images.edit)
# TRANSCRIPTION_MODEL=gpt-transcribe   # Audio transcription; defaults to whisper-1 if OPENAI_API_BASE or OPENAI_WHISPER_BASE_URL is set
# ORGANIZER_REASONING_EFFORT=low       # low | medium | high for gpt-5* / o* organizer models (@ai-sdk/openai 1.x model settings)
#
# Cost-oriented split (OpenAI list prices per 1M tokens, standard tier; check platform docs for current rates):
#   gpt-5.6-luna     default text + vision for organizer and OCR
#   gpt-5.6-terra    vision fallback when the primary vision model refuses
#
# Chat web search (OpenAI Responses API): preview web search with non-reasoning models is about $25 per 1,000 search calls;
# with reasoning models, about $10 per 1,000 search calls plus content tokens from the search.
# CHAT_WEB_SEARCH=false
# CHAT_DEEP_SEARCH=true   # Medium search context (default off)
# CHAT_REASONING_EFFORT=none  # none | low | medium | high (default none for chat). @ai-sdk/openai 2.x drops none for gpt-6; upgrade SDK before gpt-6 chat.

# Chat API: max user turns kept server-side (unset or invalid → 30; 0 or negative → no limit)
# CHAT_MAX_USER_TURNS=30

# Loops API key for newsletter and contact management
LOOPS_API_KEY="your-loops-api-key"
