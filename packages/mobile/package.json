{
  "name": "note-companion",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "clean": "git clean -xdf .expo .turbo node_modules",
    "start": "expo start --go",
    "test": "jest",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --tunnel --go",
    "android": "expo run:android",
    "dev": "expo start --go",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "verify:ios-native": "bash scripts/verify-ios-native.sh",
    "verify:ios-native:quick": "bash scripts/verify-ios-native.sh --quick",
    "verify:ios-bundle": "node scripts/verify-ios-bundle.cjs",
    "verify:ios-bundle:refresh": "node scripts/verify-ios-bundle.cjs --refresh",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "setup:eas-secrets": "bash scripts/setup-eas-secrets.sh",
    "release:ios": "bash scripts/eas.sh build --platform ios",
    "build:android": "bash scripts/eas.sh build --platform android --local",
    "build:ios": "bash scripts/eas.sh build --platform ios --local --profile production --non-interactive",
    "build:ios:remote": "bash scripts/eas.sh build --platform ios --profile production --non-interactive",
    "submit:ios": "bash scripts/eas.sh submit --platform ios --latest",
    "submit:ios:ci": "bash scripts/eas.sh submit --platform ios --latest --non-interactive",
    "build-and-submit:ios": "pnpm run build:ios:remote && pnpm run submit:ios",
    "eas-build-pre-install": "corepack enable"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": ["@clerk/expo"]
      },
      "apple": {
        "exclude": ["@clerk/expo"]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "crypto-js"
        ]
      }
    }
  },
  "dependencies": {
    "@babel/runtime": "7.26.9",
    "@clerk/expo": "^4.2.6",
    "@clerk/react": "^6.14.1",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.38",
    "@react-navigation/native": "^7.1.33",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-application": "~55.0.17",
    "expo-asset": "~55.0.18",
    "expo-auth-session": "~55.0.17",
    "expo-blur": "~55.0.16",
    "expo-build-properties": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-document-picker": "~55.0.15",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image-manipulator": "~55.0.19",
    "expo-image-picker": "~55.0.22",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-media-library": "~55.0.19",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.20",
    "expo-web-browser": "~55.0.18",
    "nativewind": "^4.1.23",
    "patch-package": "^8.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-blob-util": "^0.21.2",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/traverse--for-generate-function-map": "npm:@babel/traverse@^7.29.8",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/react-test-renderer": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eas-cli": "^21.7.0",
    "expo-doctor": "^1.18.21",
    "jest": "29.7.0",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
