{
  "name": "@note-companion/video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion kit for Note Companion video: the branded wrapper around hand-captured product footage.",
  "scripts": {
    "dev": "remotion studio",
    "build": "tsc --noEmit",
    "render:episode": "remotion render Episode out/episode.mp4",
    "render:clip": "remotion render Clip out/clip.mp4",
    "render:episode2": "remotion render Episode2 out/episode2.mp4",
    "render:clip2": "remotion render Clip2 out/clip2.mp4",
    "render:episode3": "remotion render Episode3 out/episode3.mp4",
    "render:clip3": "remotion render Clip3 out/clip3.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.416",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "remotion": "4.0.416"
  },
  "devDependencies": {
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "typescript": "catalog:"
  }
}
